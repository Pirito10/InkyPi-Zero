[Unit]
Description=InkyPi App
After=network-online.target
Wants=network-online.target

[Service]
User=root
RuntimeDirectory=inkypi
WorkingDirectory=/run/inkypi
ExecStart=/usr/local/bin/inkypi run
Restart=on-failure
RestartSec=60
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
CPUQuota=40%
# WebKitGTK (the only rendering engine now) has been measured peaking at
# ~350MB during a calendar render; 200M would cgroup-OOM-kill the service on
# every render. Needs validating against real usage on hardware.
MemoryMax=400M

[Install]
WantedBy=multi-user.target